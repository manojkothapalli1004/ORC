# Orchestrator configuration
# Copy to .env for local development. Leave provider keys blank to keep that provider in mock-safe mode.
# Do not commit real secrets.

# Provider API keys — leave blank to keep that provider in mock-safe mode
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ROUTER_API_KEY=

# Reviewer role mapping
# PROVIDER: openai | anthropic | gemini | router
# MODE: direct | router
REVIEWER_PROVIDER=openai
REVIEWER_MODE=direct
REVIEWER_MODEL=gpt-4o

# Planner role mapping
PLANNER_PROVIDER=openai
PLANNER_MODE=direct
PLANNER_MODEL=gpt-4o

# Builder role mapping
BUILDER_PROVIDER=anthropic
BUILDER_MODE=direct
BUILDER_MODEL=claude-sonnet-4-20250514

# Optional OpenAI-compatible router backend (e.g. a local 9Router endpoint)
ROUTER_BASE_URL=
ROUTER_PROVIDER_NAME=router
ROUTER_TIMEOUT_SECONDS=60

# Example router usage:
# REVIEWER_PROVIDER=router
# REVIEWER_MODE=router
# REVIEWER_MODEL=gpt-4o-mini
# ROUTER_BASE_URL=http://127.0.0.1:8787/v1

# Approval limits (auto-approve within these bounds)
MAX_FILES_PER_BATCH=5
MAX_TOKENS_PER_RESPONSE=8000

# Workflow execution mode defaults
DEFAULT_WORKFLOW_MODE=normal
COMPACT_REVIEWER_MODEL=gpt-4o-mini
COMPACT_PLANNER_MODEL=gpt-4o-mini
COMPACT_BUILDER_MODEL=claude-3-5-haiku-latest
RICH_REVIEWER_MODEL=gpt-4o
RICH_PLANNER_MODEL=gpt-4o
RICH_BUILDER_MODEL=claude-sonnet-4-20250514
GO_WILD_REVIEWER_MODEL=gpt-4.1
GO_WILD_PLANNER_MODEL=gpt-4.1
GO_WILD_BUILDER_MODEL=claude-opus-4-1-20250805

# Assistant Brain provider
# Controls which LLM backs the Assistant Brain chat panel.
# Supported values:
#   auto      — (default) tries openai first, then anthropic; falls back to mock if neither key is set
#   openai    — uses OpenAI; falls back to mock if OPENAI_API_KEY is missing
#   anthropic — uses Anthropic; falls back to mock if ANTHROPIC_API_KEY is missing
#   mock      — always uses mock (no external API calls, safe for demos)
# The active provider and fallback reason are visible in the UI badge and via GET /api/assistant/provider-status.
ASSISTANT_PROVIDER=auto
ASSISTANT_MODEL_OPENAI=gpt-4o
ASSISTANT_MODEL_ANTHROPIC=claude-sonnet-4-20250514

# Server
# Default is localhost-only. If you bind to 0.0.0.0 for phone/LAN access, set LOCAL_ACCESS_PASSWORD first.
HOST=127.0.0.1
PORT=8100
LOCAL_NETWORK_ONLY=true
LOCAL_ACCESS_USERNAME=operator
LOCAL_ACCESS_PASSWORD=

# Example local-network launch:
# HOST=0.0.0.0
# LOCAL_NETWORK_ONLY=true
# LOCAL_ACCESS_PASSWORD=change-me
# uv run uvicorn backend.app:app --reload --host 0.0.0.0 --port 8100

# Storage
# These paths are local-only runtime state and should stay out of git.
STATE_DIR=./data
LOG_DIR=./logs
BUILDER_JOB_DIR=./bridge/builder_jobs
SESSION_DIR=./data/sessions
IDEA_THREAD_DIR=./data/ideas
